# ============================================================
# DEFENDER-AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Both packages/api/ and packages/web/ read from root .env
# via their respective config loaders.
# ============================================================

# --- Required for live use ---

# Your own Anthropic API key (bring your own key: PHASE_1_MODEL_GATEWAY.md §8.1).
# Never commit it, never paste it into an issue, chat or cassette. Without it the
# backend refuses to start in live or record mode; replay mode (tests) needs none.
# Start the backend with:  cd packages/api && uvicorn src.main:app --env-file ../../.env
ANTHROPIC_API_KEY=

# PostgreSQL connection string (used by Prisma + backend)
# Example: postgresql://user:password@localhost:5432/defender_ai
DATABASE_URL=

# --- Optional (sensible defaults shown) ---

# Models (docs/MODELS.md). A run uses the primary unless it selects another model
# from the allowlist to manage cost; any model not on the list is rejected.
# CLAUDE_MODEL_PRIMARY=claude-opus-5-5
# CLAUDE_MODELS_ALLOWED=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# Gateway mode: live (default), record (write cassettes for synthetic fixtures with
# your own key), or replay (tests and CI; no key, no network).
# MODEL_GATEWAY_MODE=live
# MODEL_GATEWAY_MAX_RETRIES=2
# MODEL_GATEWAY_TIMEOUT_S=600

# Optional: your own CourtListener token (same rules as the Anthropic key).
# COURTLISTENER_API_KEY=

# Optional: append every measurement (model calls, drops, failures) as JSON Lines.
# MEASUREMENTS_PATH=./measurements.jsonl

# Directory for uploaded documents (relative to packages/api/)
# STORAGE_PATH=./uploads

# Frontend: URL of the FastAPI backend (for client-side API calls)
# The Next.js proxy rewrites /api/v1/* to this URL in development.
# NEXT_PUBLIC_API_URL=/api/v1
