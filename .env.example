# ============================================================
# DEFENDER-AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Both packages/api/ and packages/web/ read from root .env
# via their respective config loaders.
# ============================================================

# --- Required ---

# Anthropic API key for Claude LLM calls (all agents)
ANTHROPIC_API_KEY=

# PostgreSQL connection string (used by Prisma + backend)
# Example: postgresql://user:password@localhost:5432/defender_ai
DATABASE_URL=

# --- Optional (sensible defaults shown) ---

# Claude model to use for LLM calls
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Directory for uploaded documents (relative to packages/api/)
# STORAGE_PATH=./uploads

# Frontend: URL of the FastAPI backend (for client-side API calls)
# The Next.js proxy rewrites /api/v1/* to this URL in development.
# NEXT_PUBLIC_API_URL=/api/v1
