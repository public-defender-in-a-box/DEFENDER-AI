{
  "name": "defender-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"packages/web/**/*.{ts,tsx}\" && cd packages/api && black src/ tests/",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0"
  }
}
